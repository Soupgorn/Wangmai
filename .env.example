# Copy to .env at the repository root. Never commit actual credentials.
# Backend development runtime (production Compose overrides HOST).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# PostgreSQL infrastructure; replace the password for every real environment.
POSTGRES_USER=wangmai
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=wangmai
# Development binds PostgreSQL to localhost only.
POSTGRES_PORT=5432
# URL-encode special characters in the password.
# Host is localhost for native development, postgres inside production Compose.
# Development/test refuses remote hosts, different database names/ports, and URL query options.
DATABASE_URL=postgresql://wangmai:replace-with-a-strong-password@localhost:5432/wangmai

# Generate a real local secret before startup (see README). Never use the placeholder.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# These placeholders are treated as unconfigured locally; both may also be empty.
# Production requires both actual credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Production public hostname: reserved placeholder, not a working deployment.
# Set a real DNS hostname before enabling public HTTPS.
WANGMAI_DOMAIN=wangmai.example.com

# OPTIONAL frontend-only development override; put in frontend/.env.local.
# Next.js does not load the repository-root .env. This default needs no override.
# API_PROXY_ORIGIN=http://127.0.0.1:4000
# API_INTERNAL_ORIGIN=http://127.0.0.1:4000
