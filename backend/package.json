{
  "name": "@wangmai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "lint": "eslint src tests drizzle.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:check": "tsx --env-file-if-exists=../.env src/db/check.ts",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --env-file-if-exists=../.env --test tests/auth.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@wangmai/shared": "0.1.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
