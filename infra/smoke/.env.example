# PUBLIC TEST FIXTURES ONLY. Not real secrets, never use for deployment.
# The .invalid origin cannot receive a public certificate; Caddy uses HTTP only.
WANGMAI_DOMAIN=wangmai.invalid
WANGMAI_INGRESS_MODE=local-smoke
BETTER_AUTH_URL=https://wangmai.invalid
BETTER_AUTH_SECRET=local-smoke-fixture-only-never-use-in-production-000000
GOOGLE_CLIENT_ID=local-smoke-fixture.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-smoke-fixture-not-a-google-secret
POSTGRES_USER=wangmai_smoke
POSTGRES_PASSWORD=local-smoke-fixture
POSTGRES_DB=wangmai_smoke
# Legacy Phase 6A image fixtures only; current role rehearsal uses unique clusters.
POSTGRES_RUNTIME_USER=wangmai_smoke_runtime
POSTGRES_MIGRATION_USER=wangmai_smoke_migrator
DATABASE_URL=postgresql://wangmai_smoke:local-smoke-fixture@postgres:5432/wangmai_smoke
WANGMAI_IMAGE_TAG=phase6a-smoke
POSTGRES_IMAGE=postgres:18-alpine
CADDY_IMAGE=caddy:2-alpine
