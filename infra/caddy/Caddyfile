# Direct public HTTPS only; startup enables ACME. Validate without running first.
{
	# Proxy error logs can include request URIs (OAuth codes). Keep operational logs.
	log default {
		exclude http.log.access http.log.error
	}
}
import routes.caddy
{$WANGMAI_DOMAIN} {
	vars public_scheme https
	# No trusted proxies: forwarded client headers are never authoritative here.
	import wangmai_routes
}
