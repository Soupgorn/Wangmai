# Manual production only. Copy to .env.production (mode 600); never replace local .env.
# All CHANGE_ME values must be replaced. No trailing slash on BETTER_AUTH_URL.
# Active mode: provider-proxy-next with compose.provider-proxy-next.yaml.
# Historical Caddy modes require the separate rollback override and previous images.
# There is no default mode or automatic fallback.
WANGMAI_INGRESS_MODE=provider-proxy-next
WANGMAI_DOMAIN=wangmai.public.cloud.ce-nacl.com
BETTER_AUTH_URL=https://wangmai.public.cloud.ce-nacl.com
BETTER_AUTH_SECRET=CHANGE_ME_random_secret_at_least_32_characters
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# Long-running API receives only runtime credentials. Initialization is an explicit
# separate operation; password files are NOT mounted by steady-state Compose.
POSTGRES_USER=wangmai_admin
POSTGRES_DB=wangmai
POSTGRES_RUNTIME_USER=wangmai_runtime
POSTGRES_MIGRATION_USER=wangmai_migrator
DATABASE_URL=postgresql://wangmai_runtime:CHANGE_ME_runtime_password@postgres:5432/wangmai
# Operator-only secret file paths, mode 600, readable by the non-root tool UID.
# Do not put admin/migrator passwords or URLs directly in this env file.
POSTGRES_ADMIN_PASSWORD_FILE=/CHANGE_ME/secrets/postgres-admin-password
POSTGRES_RUNTIME_PASSWORD_FILE=/CHANGE_ME/secrets/postgres-runtime-password
POSTGRES_MIGRATION_PASSWORD_FILE=/CHANGE_ME/secrets/postgres-migration-password
# Contents: postgresql://wangmai_migrator:URL_ENCODED_PASSWORD@postgres:5432/wangmai
MIGRATION_DATABASE_URL_FILE=/CHANGE_ME/secrets/migration-database-url

# Reviewed commit SHA; images are built once, then retained for rollback.
WANGMAI_IMAGE_TAG=CHANGE_ME_reviewed_commit_sha
# Resolve these tags to immutable repo@sha256 digests before production startup.
POSTGRES_IMAGE=postgres:18-alpine
# Provider security gates. Leave unverified until administrators provide reviewed evidence.
# Space-separated narrow canonical IPv4 CIDRs (/16 through /32) of actual TCP peers; no blanket RFC1918 trust.
WANGMAI_GATEWAY_CIDRS=
WANGMAI_ORIGIN_BIND_IP=10.60.2.22
WANGMAI_GATEWAY_HEADERS_VERIFIED=unverified
WANGMAI_ORIGIN_CONFIDENTIALITY_VERIFIED=unverified
WANGMAI_ORIGIN_SOURCE_RESTRICTION_VERIFIED=unverified
WANGMAI_ORIGIN_INTEGRITY_VERIFIED=unverified
# ipsec | wireguard | macsec | provider-encrypted-private-network; evidence required.
# A private VLAN, source allowlist or public TLS termination alone does not protect HTTP.
WANGMAI_ORIGIN_LINK_PROTECTION=unverified
WANGMAI_GATEWAY_CONTRACT_REFERENCE=
# NODE_ENV=production, internal hostnames and bind ports are set by Compose.
# Historical TLS/Caddy settings are documented in docs/historical-caddy-deployment.md.
